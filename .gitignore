# Build output. Holds copies of the game's own assemblies - Assembly-CSharp.dll,
# Facepunch.Steamworks.dll and friends - which have no business in a repository.
[Bb]in/
[Oo]bj/
/packages/

# Packed by the release workflow, never committed.
*.zip

# Generated on every build
FodyWeavers.xsd
costura_files.txt

# Claude Code checks out a second copy of the repo in here to work in isolation.
# It is a git worktree, so git already knows about it - it must not also be committed.
/.claude/worktrees/

# JetBrains Rider
/.idea/
riderModule.iml
/_ReSharper.Caches/
*.DotSettings.user
*.sln.DotSettings.user

# Visual Studio user state
*.user
*.userosscache
*.suo
*.userprefs

# Local secrets. The release pipeline reads its token from GitHub, not from a file,
# but this keeps an experiment from becoming a leak.
.env